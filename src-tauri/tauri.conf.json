{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elementary",
  "version": "0.1.0",
  "identifier": "com.elementary.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Elementary",
        "create": false,
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 760,
        "theme": "Dark",
        "backgroundColor": "#1b1b1b",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "stories/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}